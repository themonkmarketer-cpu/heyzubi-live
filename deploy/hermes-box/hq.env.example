# HeyZubi on hermes-box. Copied to /opt/hq/data/hq.env (inside the heyzubi-live container, kept in its data volume).
# Keys are typed in by the owner on the server; never paste them into a chat.

# ---- the app ----
PORT=8787
# The Tailscale HTTPS address that `tailscale serve` gives the app (only devices on your tailnet reach it).
APP_URL=https://hermes-box.example.ts.net:8443
SERVER_URL=https://hermes-box.example.ts.net:8443
SESSION_SECRET=
DEV_LOGIN=0
# The Google account(s) that may sign in, and the owner, whose first bot is the agent that already runs.
ALLOWED_EMAILS=you@example.com
OWNER_EMAIL=you@example.com
DB_PATH=/opt/hq/data/hq.db

# ---- the agents (Hermes) ----
# The real binary, not /opt/hermes/bin/hermes: that shim drops root to the `hermes` user, which cannot
# read the extra bots' homes.
HERMES_BIN=/opt/hermes/.venv/bin/hermes
HERMES_URL=http://127.0.0.1:8642
HERMES_HOME_PRIMARY=/opt/data
ENGINES_DIR=/opt/hq/data/engines
PRIMARY_BOT_NAME=Zubi
PRIMARY_BOT_LABEL=Chief of Staff
MAX_BOTS=4

# ---- the computer: this machine, with local screens ----
HQ_SCREENS=local
HQ_SCREENS_DIR=/opt/hq/data/screens
HQ_SCREEN_SIZE=1280x800

# ---- connectors, X research, voice (typed in by the owner) ----
COMPOSIO_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Optional: your YouTube channel id (UC…), for the YouTube window (latest public videos, no sign-in).
# HQ_YOUTUBE_CHANNEL=
